---
// Import the layout
import BaseLayout from '../layouts/BaseLayout.astro';
import AttributionFields from '../components/AttributionFields.astro';
import VideoThumbnail from '../components/VideoThumbnail.astro';
import VideoModal from '../components/VideoModal.astro';
import DonateButton from '../components/DonateButton.astro';
import { Image } from 'astro:assets';
import ericPhoto from '../assets/eric.webp';
import votePhoto from '../assets/vote.webp';
import siteText from '../data/site-text.json';
// Define the unique data for this specific page
const pageTitle = "Eric Stafford for Arizona State Senate, LD29 | Putting Arizonans First";
const pageUrl = '/';
const pageDescription = "Eric Stafford, Democratic nominee for Arizona State Senate in LD29: Surprise, El Mirage, Glendale, Goodyear and the West Valley. Lower costs, fair wages, strong schools.";
const links = siteText.global.links;
const homeText = siteText.home;
const homeForm = homeText.form;
const donations = siteText.global.donations;
const donateAmounts = [
    { href: links.donate5, amount: '5', label: '$5' },
    { href: links.donate10, amount: '10', label: '$10' },
    { href: links.donate25, amount: '25', label: '$25' },
    { href: links.donate50, amount: '50', label: '$50' },
    { href: links.donate100, amount: '100', label: '$100' },
    { href: links.donate, amount: 'other', label: homeText.donateOtherLabel, other: true },
];
---

<BaseLayout 
    title={pageTitle} 
    canonicalUrl={pageUrl} 
    description={pageDescription}
    alternates={[
        { hreflang: 'en', path: '/' },
        { hreflang: 'es', path: '/es' },
        { hreflang: 'x-default', path: '/' },
    ]}
>


<!-- Hero Section -->
<section class="hero" id="home">
    <div class="hero-content-wrapper">
        <div class="hero-text-and-buttons">
            <h1>
                {homeText.heroTitleLines.map((line, i) => (
                    <span class:list={['hero-title-line', { name: i === 0 }]}>{line}</span>
                ))}
            </h1>
            <p class="hero-subtitle">{homeText.heroSubtitle}</p>
            <div class="hero-buttons">
                <a href={links.platform} class="btn">{homeText.heroPrimaryCta}</a>
                <DonateButton class="btn" label={homeText.heroDonateCta} />
            </div>
        </div>
        <div class="hero-headshot-container">
            <Image src={ericPhoto} alt="Eric Stafford Headshot" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 1024px) 400px, 500px" loading="eager" fetchpriority="high" />
        </div>
    </div>
</section>

<!-- About / Signup Section -->
<section class="about-section" id="contact">
    <div class="about-image"> 
        <h2>{homeText.signupTitle}</h2>
        <p class="disclaimer-large">
            {homeText.signupDisclaimer}
        </p>
    </div>
    
    <div class="about-content">
    <form class="campaign-form" name="campaign-signup" method="POST" data-netlify="true" action={links.thankYou}>
            <input type="hidden" name="form-name" value="campaign-signup">
            <AttributionFields />

            <div class="form-row">
                <div class="form-group">
                    <label for="first-name">{homeForm.firstNameLabel}</label>
                    <input type="text" id="first-name" name="first-name" required>
                </div>
                <div class="form-group">
                    <label for="last-name">{homeForm.lastNameLabel}</label>
                    <input type="text" id="last-name" name="last-name" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="zip-code">{homeForm.zipCodeLabel}</label>
                    <input type="text" id="zip-code" name="zip-code" pattern="[0-9]{5}" title="Please enter a 5-digit zip code" required>
                </div>
                <div class="form-group">
                    <label for="phone">{homeForm.phoneLabel}</label>
                    <input type="tel" id="phone" name="phone">
                </div>
            </div>

            <div class="form-group full-width">
                <label for="email">{homeForm.emailLabel}</label>
                <input type="email" id="email" name="email" required>
            </div>
            
            <button type="submit" class="btn submit-btn">{homeForm.submitLabel}</button>
        </form>
    </div>
</section>

<!-- Voter Resources CTA -->
<section class="home-voter-cta reveal">
    <div class="home-voter-cta-content">
        <div class="home-voter-cta-actions">
            <a href={links.voterResources} class="btn home-voter-btn">{homeText.voterResourcesLabel}</a>
            <a href={links.checkVoterStatus} class="btn home-voter-btn-secondary" target="_blank" rel="noopener">{homeText.inDistrictLabel}</a>
        </div>
        <div class="home-voter-cta-text">
            <h2>{homeText.voterCtaTitle}</h2>
            <p>{homeText.voterCtaBody}</p>
        </div>
    </div>
</section>

<!-- Video Section -->
<section class="video-section reveal" id="video">
    <div class="video-content-wrapper">
        <div class="video-text">
            <h2>{homeText.videoTitle}</h2>
            <p>{homeText.videoBody}</p>
        </div>
    </div>
    <VideoThumbnail />
</section>

<!-- Video Modal -->
<VideoModal videoUrl="/assets/campaign-video.mp4" />

<!-- Donate Section -->
<section class="donate-section reveal">
    <h2>
        {homeText.donateTitleLines[0]}<br>
        {homeText.donateTitleLines[1]}<br>
        {homeText.donateTitleLines[2]}
    </h2>
    <div class="donate-amounts">
        {donateAmounts.map(({ href, amount, label, other }) => donations.open ? (
            <a href={href} target="_blank">
            <button class:list={['donate-amount-btn', { other }]} data-amount={amount}>{label}</button>
            </a>
        ) : (
            <span>
            <button class:list={['donate-amount-btn', { other }]} data-amount={amount} disabled>{label}</button>
            </span>
        ))}
        {!donations.open && <p class="donate-closed-note">{donations.closedNote}</p>}
    </div>
</section>

<!-- Platform Section -->
<section class="platform-section reveal" id="platform">
    <div class="platform-image-container">
        <Image src={votePhoto} alt="Eric Stafford State Senator Candidate Holding Vote Hat" width={2000} widths={[800, 1400, 2000]} sizes="(max-width: 1024px) 750px, 1400px" loading="lazy" style="max-width:100%;height:auto;" />
    </div>
    <div class="platform-content-wrapper">
        <div class="platform-text">
            <h2>{homeText.platformTitle}</h2>
            <p>
                {homeText.platformBody}
            </p>
        </div>
    </div>
</section>

</BaseLayout>

<style>
/* Hero title: one line per entry in home.heroTitleLines */
.hero-title-line {
    display: block;
}
.hero-title-line + .hero-title-line {
    margin-top: 0.12em;
}
.hero h1 .name {
    margin-bottom: 0.18em;
}

/* Donate section when donations are closed (global.donations.open = false) */
.donate-amount-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

.donate-closed-note {
    flex-basis: 100%;
    grid-column: 1 / -1;
    text-align: right;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--main-blue);
}

@media (max-width: 768px) {
    .donate-closed-note {
        text-align: center;
    }
}

/* Home Voter Resources CTA */
.home-voter-cta {
    background: linear-gradient(135deg, var(--main-blue), #122940);
    padding: 60px 60px;
}

.home-voter-cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    max-width: 1100px;
    margin: 0 auto;
}

.home-voter-cta-text h2 {
    font-size: 30px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--off-white);
    margin-bottom: 12px;
}

.home-voter-cta-text p {
    font-size: 16px;
    color: var(--off-white);
    opacity: 0.85;
    line-height: 1.7;
    max-width: 480px;
}

.home-voter-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
}

.home-voter-btn {
    background: var(--bg-orange);
    border-color: var(--bg-orange);
    color: var(--main-blue);
    padding: 14px 32px;
    font-weight: 700;
    text-align: center;
}

.home-voter-btn:hover {
    background: #e8943e;
    border-color: #e8943e;
}

.home-voter-btn-secondary {
    border-color: var(--off-white);
    color: var(--off-white);
    padding: 14px 32px;
    text-align: center;
}

.home-voter-btn-secondary:hover {
    background: var(--off-white);
    color: var(--main-blue);
}

@media (max-width: 768px) {
    .home-voter-cta {
        padding: 40px 20px;
    }

    .home-voter-cta-content {
        flex-direction: column;
        text-align: center;
    }

    .home-voter-cta-text h2 {
        font-size: 24px;
    }

    .home-voter-cta-actions {
        width: 100%;
    }
}
</style>