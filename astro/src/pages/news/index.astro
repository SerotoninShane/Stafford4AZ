---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) =>
    date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const blogSchema = {
    '@type': 'Blog',
    '@id': 'https://stafford4az.com/news#blog',
    name: 'Eric Stafford for Arizona Senate: News',
    publisher: { '@id': 'https://stafford4az.com/#campaign' },
    blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.heading,
        url: `https://stafford4az.com/news/${post.id}/`,
        datePublished: post.data.date.toISOString(),
    })),
};
---

<ContentLayout
    title="News & Updates | Eric Stafford for Arizona State Senate, LD29"
    canonicalUrl="/news"
    description="News, voter guides and updates from Eric Stafford's campaign for Arizona State Senate in Legislative District 29 (LD29), including Surprise and the West Valley."
    heading="News & Updates"
    breadcrumbs={[{ name: 'News', path: '/news' }]}
    pageType="CollectionPage"
    schema={[blogSchema]}
>
    <p class="lead">Updates from the campaign, plus guides for LD29 voters in Surprise, El Mirage, Glendale, Goodyear, Litchfield Park and Wittmann.</p>

    {posts.map((post) => (
        <section>
            <h2><a href={`/news/${post.id}`}>{post.data.heading}</a></h2>
            <p class="content-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
            <p>{post.data.description}</p>
        </section>
    ))}
</ContentLayout>
